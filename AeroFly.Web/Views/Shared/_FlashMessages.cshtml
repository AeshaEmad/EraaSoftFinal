@using System.Text.Json

@if (TempData["Success"] != null)
{
    <script>
        toastr.success(@Html.Raw(JsonSerializer.Serialize(TempData["Success"])));
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        toastr.error(@Html.Raw(JsonSerializer.Serialize(TempData["Error"])));
    </script>
}

@if (TempData["Warning"] != null)
{
    <script>
        toastr.warning(@Html.Raw(JsonSerializer.Serialize(TempData["Warning"])));
    </script>
}

@if (TempData["Info"] != null)
{
    <script>
        toastr.info(@Html.Raw(JsonSerializer.Serialize(TempData["Info"])));
    </script>
}
