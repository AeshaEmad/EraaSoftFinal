@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_MainLayout";
}

@section Styles {
    <style>
        body {
            background: #0a0a1a;
        }

        .auth-wrapper {
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 16px;
        }

        .auth-card {
            background: #111827;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 20px;
            padding: 40px;
            width: 100%;
            max-width: 460px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        }

        .auth-logo {
            font-size: 48px;
            text-align: center;
            margin-bottom: 8px;
        }

        .auth-card h1 {
            color: #fff;
            font-size: 24px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 4px;
        }

        .auth-card p.subtitle {
            color: #888;
            text-align: center;
            font-size: 14px;
            margin-bottom: 28px;
        }

        .form-label {
            color: #ccc;
            font-size: 14px;
            font-weight: 500;
        }

        .form-control {
            background: #1f2937;
            border: 1px solid rgba(255,255,255,0.1);
            color: #fff;
            border-radius: 10px;
            padding: 12px 16px;
        }

            .form-control:focus {
                background: #1f2937;
                border-color: #0d6efd;
                color: #fff;
                box-shadow: 0 0 0 3px rgba(13,110,253,0.15);
            }

            .form-control::placeholder {
                color: #4b5563;
            }

        .btn-auth {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 50px;
            background: linear-gradient(135deg, #dc3545, #fd7e14);
            color: #fff;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 8px;
            transition: opacity .2s;
        }

            .btn-auth:hover {
                opacity: 0.9;
            }

        .auth-footer {
            text-align: center;
            margin-top: 20px;
            color: #888;
            font-size: 14px;
        }

            .auth-footer a {
                color: #4da6ff;
                text-decoration: none;
            }

                .auth-footer a:hover {
                    text-decoration: underline;
                }

        .text-danger {
            font-size: 12px;
        }
    </style>
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo">🔐</div>
        <h1>Reset Password</h1>
        <p class="subtitle">Choose a strong new password</p>

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Token" type="hidden" />
            <input asp-for="Email" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">🔑 New Password</label>
                <input asp-for="NewPassword" class="form-control" type="password" placeholder="At least 6 characters" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">🔑 Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Re-enter your password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-auth">Reset Password ✅</button>
        </form>

        <div class="auth-footer">
            <a asp-action="Login">← Back to Login</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}