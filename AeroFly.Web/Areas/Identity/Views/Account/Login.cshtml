@model LoginViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Sign in"];
    Layout = "_MainLayout";
}

@section Styles {
    <style>
        body {
            background: #0a0a1a;
        }

        .auth-section {
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 16px;
            background: linear-gradient(135deg, #0a0a1a 0%, #1a1a3e 100%);
        }

        .auth-card {
            background: #111827;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 24px;
            padding: 48px 40px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        }

            .auth-card h2 {
                color: #fff;
                font-weight: 700;
                font-size: 28px;
                margin-bottom: 8px;
            }

            .auth-card p {
                color: #888;
                font-size: 14px;
                margin-bottom: 28px;
            }

        .auth-input-group {
            margin-bottom: 20px;
        }

            .auth-input-group label {
                color: #ccc;
                font-size: 13px;
                font-weight: 600;
                margin-bottom: 8px;
                display: block;
            }

        .auth-input {
            width: 100%;
            padding: 12px 16px;
            background: #1f2937;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            color: #fff;
            font-size: 14px;
            transition: all 0.3s;
        }

            .auth-input:focus {
                outline: none;
                border-color: #0d6efd;
                box-shadow: 0 0 0 3px rgba(13,110,253,0.15);
            }

            .auth-input::placeholder {
                color: #4b5563;
            }

        .btn-auth {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #0d6efd, #0dcaf0);
            color: #fff;
            border: none;
            border-radius: 50px;
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            transition: opacity 0.2s;
        }

            .btn-auth:hover {
                opacity: 0.9;
            }

        .auth-footer {
            text-align: center;
            margin-top: 24px;
            color: #888;
            font-size: 14px;
        }

            .auth-footer a {
                color: #4da6ff;
                text-decoration: none;
                font-weight: 600;
            }

                .auth-footer a:hover {
                    text-decoration: underline;
                }

        .field-error {
            color: #dc3545;
            font-size: 12px;
            margin-top: 4px;
            display: block;
        }
    </style>
}

<section class="auth-section">
    <div class="auth-card">
        <h2>@L["Welcome back"]</h2>
        <p>@L["Sign in to manage your flights and rewards."]</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success py-2 small">@TempData["SuccessMessage"]</div>
        }

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="auth-input-group">
                <label asp-for="Email">@L["Email Address"]</label>
                <input asp-for="Email" class="auth-input" placeholder="@L["Enter your email"]" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="auth-input-group">
                <label asp-for="Password" class="d-flex justify-content-between">
                    <span>@L["Password"]</span>
                    <a asp-action="ForgotPassword" style="font-size: 12px; color: #4da6ff; text-decoration: none;">@L["Forgot?"]</a>
                </label>
                <input asp-for="Password" class="auth-input" placeholder="@L["Enter your password"]" type="password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="auth-input-group d-flex align-items-center" style="margin-bottom: 16px;">
                <input asp-for="RememberMe" class="form-check-input me-2" type="checkbox" />
                <label asp-for="RememberMe" class="form-check-label" style="font-size: 14px; color: #ccc;">@L["Remember me"]</label>
            </div>

            <button type="submit" class="btn-auth">@L["Sign in"]</button>
        </form>

        <div class="auth-footer">
            @L["Don't have an account?"]
            <a asp-action="Register">@L["Join AeroFly+"]</a>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
