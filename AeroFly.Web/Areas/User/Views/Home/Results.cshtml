@model List<FlightResultVM>
@{
    ViewData["Title"] = "Flight Results";
    var passengerCount = ViewBag.PassengerCount ?? 1;
}

<section class="results-section py-4">
    <div class="container">
        <!-- Back to Search -->
        <div class="mb-4">
            <a asp-area="User" asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left me-1"></i> Modify Search
            </a>
        </div>

        <!-- Results Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>
                <i class="fas fa-plane me-2"></i>
                @Model.Count Flight(s) Found
            </h2>
            <span class="badge bg-primary">@passengerCount Passenger(s)</span>
        </div>

        @if (Model.Any())
        {
            <div class="row">
                @foreach (var flight in Model)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="flight-card">
                            <div class="flight-card-header">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="flight-number">@flight.FlightNum</span>
                                    <span class="badge bg-@(flight.IsAvailable ? "success" : "danger")">
                                        @(flight.IsAvailable ? "Available" : "Full")
                                    </span>
                                </div>
                            </div>

                            <div class="flight-card-body">
                                <!-- Route -->
                                <div class="route-display">
                                    <div class="departure">
                                        <div class="time">@flight.DepartureTime.ToString("HH:mm")</div>
                                        <div class="city">@flight.DepartureCity</div>
                                        <div class="iata">@flight.DepartureIata</div>
                                    </div>

                                    <div class="flight-line">
                                        <div class="line"></div>
                                        <div class="duration">@flight.DurationHours</div>
                                        <div class="line"></div>
                                    </div>

                                    <div class="arrival">
                                        <div class="time">@flight.ArrivalTime.ToString("HH:mm")</div>
                                        <div class="city">@flight.ArrivalCity</div>
                                        <div class="iata">@flight.ArrivalIata</div>
                                    </div>
                                </div>

                                <!-- Details -->
                                <div class="flight-details mt-3">
                                    <div class="row text-center">
                                        <div class="col-6">
                                            <small class="text-muted">Departure Date</small>
                                            <div class="fw-bold">@flight.DepartureTime.ToString("dd MMM yyyy")</div>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted">Available Seats</small>
                                            <div class="fw-bold">@flight.AvailableSeats</div>
                                        </div>
                                    </div>

                                    <div class="row text-center mt-2">
                                        <div class="col-12">
                                            <small class="text-muted">Price per Passenger</small>
                                            <div class="price">$@flight.PricePerPassenger.ToString("N0")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="flight-card-footer">
                                @if (flight.IsAvailable)
                                {
                                    <a asp-area="User" asp-controller="Home" asp-action="Details"
                                       asp-route-id="@flight.FlightId" asp-route-passengers="@passengerCount"
                                       class="btn btn-primary w-100">
                                        <i class="fas fa-ticket-alt me-2"></i> Select Flight
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary w-100" disabled>
                                        <i class="fas fa-times-circle me-2"></i> Not Available
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-plane-slash fa-4x text-muted mb-3"></i>
                <h4 class="text-muted">No flights found</h4>
                <p class="text-muted">Try adjusting your search criteria</p>
                <a asp-area="User" asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="fas fa-search me-1"></i> New Search
                </a>
            </div>
        }
    </div>
</section>

@section Styles {
    <style>
        .results-section {
            background: #f8f9fa;
            min-height: 80vh;
        }

        .flight-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            overflow: hidden;
            transition: transform 0.3s, box-shadow 0.3s;
        }

            .flight-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 30px rgba(0,0,0,0.12);
            }

        .flight-card-header {
            padding: 15px 20px;
            background: #f8f9fa;
            border-bottom: 1px solid #e9ecef;
        }

        .flight-number {
            font-weight: 700;
            font-size: 16px;
            color: #0d6efd;
        }

        .flight-card-body {
            padding: 20px;
        }

        .route-display {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 0;
        }

        .departure, .arrival {
            text-align: center;
            flex: 1;
        }

            .departure .time, .arrival .time {
                font-size: 24px;
                font-weight: 700;
                color: #1a1a2e;
            }

            .departure .city, .arrival .city {
                font-size: 14px;
                font-weight: 600;
                color: #333;
            }

            .departure .iata, .arrival .iata {
                font-size: 12px;
                color: #6c757d;
            }

        .flight-line {
            display: flex;
            align-items: center;
            flex: 1.5;
            padding: 0 10px;
        }

            .flight-line .line {
                flex: 1;
                height: 2px;
                background: #dee2e6;
                position: relative;
            }

                .flight-line .line::after {
                    content: '✈';
                    position: absolute;
                    top: -10px;
                    left: 50%;
                    transform: translateX(-50%);
                    color: #0d6efd;
                }

            .flight-line .duration {
                padding: 0 15px;
                font-size: 12px;
                color: #6c757d;
                white-space: nowrap;
            }

        .price {
            font-size: 28px;
            font-weight: 700;
            color: #0d6efd;
        }

        .flight-card-footer {
            padding: 15px 20px;
            background: #f8f9fa;
            border-top: 1px solid #e9ecef;
        }
    </style>
}