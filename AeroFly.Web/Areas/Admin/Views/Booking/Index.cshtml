@model List<BookingListVM>
@{
    ViewData["Title"] = "Bookings Management";
}

<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <h3 class="card-title">
                <i class="fas fa-ticket-alt me-2"></i> All Bookings
            </h3>
            <span class="badge bg-primary">@Model.Count Total</span>
        </div>
    </div>
    <div class="card-body">
        <!-- Filter Section -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="card card-secondary">
                    <div class="card-header">
                        <h5 class="card-title">
                            <i class="fas fa-filter me-1"></i> Filters
                        </h5>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <form method="get" class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Search</label>
                                <input type="text" name="searchTerm" class="form-control form-control-sm"
                                       placeholder="PNR, Name, Email, Flight" value="@Context.Request.Query["searchTerm"]" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Status</label>
                                <select name="status" class="form-control form-control-sm">
                                    <option value="">All</option>
                                    @foreach (var s in ViewBag.Statuses)
                                    {
                                        <option value="@s" selected="@(Context.Request.Query["status"] == s)">@s</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Payment</label>
                                <select name="paymentStatus" class="form-control form-control-sm">
                                    <option value="">All</option>
                                    @foreach (var ps in ViewBag.PaymentStatuses)
                                    {
                                        <option value="@ps" selected="@(Context.Request.Query["paymentStatus"] == ps)">@ps</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">From Date</label>
                                <input type="date" name="fromDate" class="form-control form-control-sm"
                                       value="@Context.Request.Query["fromDate"]" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">To Date</label>
                                <input type="date" name="toDate" class="form-control form-control-sm"
                                       value="@Context.Request.Query["toDate"]" />
                            </div>
                            <div class="col-md-1 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="fas fa-search"></i>
                                </button>
                                <a asp-action="Index" class="btn btn-secondary btn-sm ms-1">
                                    <i class="fas fa-undo"></i>
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Results Table -->
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped" id="bookingsTable">
                    <thead>
                        <tr>
                            <th>PNR</th>
                            <th>Passenger</th>
                            <th>Flight</th>
                            <th>Route</th>
                            <th>Departure</th>
                            <th>Passengers</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th style="width: 130px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@booking.PNR</strong>
                                </td>
                                <td>
                                    <div>@booking.PassengerName</div>
                                    <small class="text-muted">@booking.Email</small>
                                </td>
                                <td>
                                    <span class="badge bg-info">@booking.FlightNumber</span>
                                </td>
                                <td>
                                    <small>
                                        <span class="badge bg-primary">@booking.DepartureIata</span>
                                        <i class="fas fa-arrow-right mx-1"></i>
                                        <span class="badge bg-primary">@booking.ArrivalIata</span>
                                    </small>
                                </td>
                                <td>
                                    <small>@booking.DepartureTime.ToString("dd/MM HH:mm")</small>
                                </td>
                                <td>@booking.PassengerCount</td>
                                <td>$@booking.TotalPrice.ToString("N2")</td>
                                <td>
                                    <span class="badge bg-@booking.StatusColor">@booking.Status</span>
                                </td>
                                <td>
                                    @if (booking.PaymentStatus == "Completed")
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else if (booking.PaymentStatus == "Pending")
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                    else if (booking.PaymentStatus == "Refunded")
                                    {
                                        <span class="badge bg-info">Refunded</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Not Paid</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@booking.BookingId"
                                           class="btn btn-info btn-sm" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (booking.Status != "Cancelled" && booking.Status != "Completed")
                                        {
                                            <a asp-action="Cancel" asp-route-id="@booking.BookingId"
                                               class="btn btn-warning btn-sm" title="Cancel"
                                               onclick="return confirm('Cancel this booking?')">
                                                <i class="fas fa-times"></i>
                                            </a>
                                        }
                                        <a asp-action="Delete" asp-route-id="@booking.BookingId"
                                           class="btn btn-danger btn-sm" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-ticket-alt fa-4x text-muted mb-3"></i>
                <h5 class="text-muted">No bookings found</h5>
                <p class="text-muted">Bookings will appear here when users make reservations.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($('#bookingsTable tbody tr').length > 0) {
                $('#bookingsTable').DataTable({
                    language: {
                        search: "Search:",
                        lengthMenu: "Show _MENU_ entries",
                        info: "Showing _START_ to _END_ of _TOTAL_ bookings",
                    },
                    order: [[4, 'desc']],
                    pageLength: 10
                });
            }
        });
    </script>
}
