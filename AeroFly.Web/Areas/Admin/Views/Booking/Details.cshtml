@model BookingDetailsVM
@{
    ViewData["Title"] = "Booking Details";
}

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="card-title">
                        <i class="fas fa-ticket-alt me-2"></i> Booking @Model.PNR
                    </h3>
                    <div>
                        <span class="badge bg-@(Model.Status == "Confirmed" ? "success" : Model.Status == "Pending" ? "warning" : Model.Status == "Cancelled" ? "danger" : "info")" style="font-size:14px;">
                            @Model.Status
                        </span>
                        @if (Model.Status != "Cancelled" && Model.Status != "Completed")
                        {
                            <a asp-action="Cancel" asp-route-id="@Model.BookingId" class="btn btn-warning btn-sm ms-1"
                               onclick="return confirm('Cancel this booking?')">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                        }
                        <a asp-action="Delete" asp-route-id="@Model.BookingId" class="btn btn-danger btn-sm ms-1">
                            <i class="fas fa-trash me-1"></i> Delete
                        </a>
                        <a asp-action="Index" class="btn btn-secondary btn-sm ms-2">
                            <i class="fas fa-arrow-left me-1"></i> Back
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Booking Info -->
                    <div class="col-md-6">
                        <div class="card card-info">
                            <div class="card-header">
                                <h5 class="card-title">Booking Information</h5>
                            </div>
                            <div class="card-body">
                                <dl class="row mb-0">
                                    <dt class="col-sm-4">PNR</dt>
                                    <dd class="col-sm-8"><strong>@Model.PNR</strong></dd>

                                    <dt class="col-sm-4">Booking Date</dt>
                                    <dd class="col-sm-8">@Model.BookingDate.ToString("dd/MM/yyyy HH:mm")</dd>

                                    <dt class="col-sm-4">Status</dt>
                                    <dd class="col-sm-8">
                                        <span class="badge bg-@(Model.Status == "Confirmed" ? "success" : Model.Status == "Pending" ? "warning" : Model.Status == "Cancelled" ? "danger" : "info")">
                                            @Model.Status
                                        </span>
                                    </dd>

                                    <dt class="col-sm-4">Total Price</dt>
                                    <dd class="col-sm-8"><strong>$@Model.TotalPrice.ToString("N2")</strong></dd>

                                    <dt class="col-sm-4">Points Used</dt>
                                    <dd class="col-sm-8">@Model.PointsUsed</dd>

                                    <dt class="col-sm-4">Discount Applied</dt>
                                    <dd class="col-sm-8">@(Model.DiscountApplied ? "✅ Yes" : "❌ No")</dd>
                                </dl>
                            </div>
                        </div>
                    </div>

                    <!-- Passenger Info -->
                    <div class="col-md-6">
                        <div class="card card-success">
                            <div class="card-header">
                                <h5 class="card-title">Passenger Information</h5>
                            </div>
                            <div class="card-body">
                                <dl class="row mb-0">
                                    <dt class="col-sm-4">Full Name</dt>
                                    <dd class="col-sm-8"><strong>@Model.UserFullName</strong></dd>

                                    <dt class="col-sm-4">Email</dt>
                                    <dd class="col-sm-8">@Model.UserEmail</dd>

                                    <dt class="col-sm-4">Passengers</dt>
                                    <dd class="col-sm-8">@Model.Passengers.Count</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Flight Info -->
                <div class="row mt-3">
                    <div class="col-md-12">
                        <div class="card card-primary">
                            <div class="card-header">
                                <h5 class="card-title">Flight Information</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <dl class="row mb-0">
                                            <dt class="col-sm-4">Flight Number</dt>
                                            <dd class="col-sm-8"><span class="badge bg-info">@Model.FlightNumber</span></dd>

                                            <dt class="col-sm-4">Route</dt>
                                            <dd class="col-sm-8">
                                                <strong>@Model.DepartureIata</strong>
                                                <i class="fas fa-arrow-right mx-2"></i>
                                                <strong>@Model.ArrivalIata</strong>
                                            </dd>

                                            <dt class="col-sm-4">Departure</dt>
                                            <dd class="col-sm-8">
                                                @Model.DepartureTime.ToString("dd/MM/yyyy HH:mm")
                                                <br />
                                                <small class="text-muted">@Model.DepartureAirport</small>
                                            </dd>

                                            <dt class="col-sm-4">Arrival</dt>
                                            <dd class="col-sm-8">
                                                @Model.ArrivalTime.ToString("dd/MM/yyyy HH:mm")
                                                <br />
                                                <small class="text-muted">@Model.ArrivalAirport</small>
                                            </dd>
                                        </dl>
                                    </div>
                                    <div class="col-md-6">
                                        <dl class="row mb-0">
                                            <dt class="col-sm-4">Duration</dt>
                                            <dd class="col-sm-8">@Model.Duration.ToString(@"hh\:mm")</dd>

                                            <dt class="col-sm-4">Available Seats</dt>
                                            <dd class="col-sm-8">@Model.AvailableSeats</dd>

                                            <dt class="col-sm-4">Payment Status</dt>
                                            <dd class="col-sm-8">
                                                @if (Model.PaymentStatus == "Completed")
                                                {
                                                    <span class="badge bg-success">Paid</span>
                                                }
                                                else if (Model.PaymentStatus == "Pending")
                                                {
                                                    <span class="badge bg-warning">Pending</span>
                                                }
                                                else if (Model.PaymentStatus == "Refunded")
                                                {
                                                    <span class="badge bg-info">Refunded</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Not Paid</span>
                                                }
                                            </dd>

                                            @if (!string.IsNullOrEmpty(Model.PaymentMethod))
                                            {
                                                <dt class="col-sm-4">Payment Method</dt>
                                                <dd class="col-sm-8">@Model.PaymentMethod</dd>
                                            }

                                            @if (Model.PaymentDate.HasValue)
                                            {
                                                <dt class="col-sm-4">Payment Date</dt>
                                                <dd class="col-sm-8">@Model.PaymentDate.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                                            }
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Passengers List -->
                <div class="row mt-3">
                    <div class="col-md-12">
                        <div class="card card-warning">
                            <div class="card-header">
                                <h5 class="card-title">
                                    <i class="fas fa-users me-2"></i> Passengers List
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-striped mb-0">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Full Name</th>
                                            <th>Passport</th>
                                            <th>Age</th>
                                            <th>Seat Class</th>
                                            <th>Seat</th>
                                            <th>Ticket</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Passengers.Any())
                                        {
                                            int counter = 1;
                                            foreach (var passenger in Model.Passengers)
                                            {
                                                <tr>
                                                    <td>@counter</td>
                                                    <td><strong>@passenger.FullName</strong></td>
                                                    <td>@passenger.PassportNumber</td>
                                                    <td>@passenger.Age</td>
                                                    <td>
                                                        <span class="badge bg-secondary">@passenger.SeatClass</span>
                                                    </td>
                                                    <td>@(passenger.SeatNumber ?? "-")</td>
                                                    <td>@(passenger.TicketNumber ?? "-")</td>
                                                </tr>
                                                counter++;
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center text-muted">No passengers found</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
