@model AirportVM
@{
    ViewData["Title"] = "Delete Airport";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title">
                    <i class="fas fa-exclamation-triangle me-2"></i> Delete Airport
                </h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong>Are you sure you want to delete this airport?</strong>
                    <p class="mt-2 mb-0">This action cannot be undone.</p>
                </div>

                <div class="card bg-light mb-3">
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-3 text-muted">IATA Code</dt>
                            <dd class="col-sm-9">
                                <span class="badge bg-primary">@Model.IataCode</span>
                            </dd>

                            <dt class="col-sm-3 text-muted">Airport Name</dt>
                            <dd class="col-sm-9"><strong>@Model.Name</strong></dd>

                            <dt class="col-sm-3 text-muted">City</dt>
                            <dd class="col-sm-9">@Model.City</dd>

                            <dt class="col-sm-3 text-muted">Country</dt>
                            <dd class="col-sm-9">@Model.Country</dd>

                            <dt class="col-sm-3 text-muted">Coordinates</dt>
                            <dd class="col-sm-9">@Model.Latitude°, @Model.Longitude°</dd>
                        </dl>
                    </div>
                </div>

                <form asp-action="DeleteConfirmed" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="AirportId" type="hidden" />

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i> Confirm Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>