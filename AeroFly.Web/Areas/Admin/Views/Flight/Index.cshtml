@model List<FlightVM>
@{
    ViewData["Title"] = "Flights Management";
}

<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <h3 class="card-title">
                <i class="fas fa-plane me-2"></i> All Flights
            </h3>
            <div>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i> Add New Flight
                </a>
            </div>
        </div>
    </div>
    <div class="card-body">
        <!-- Filter Section -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="card card-secondary">
                    <div class="card-header">
                        <h5 class="card-title">
                            <i class="fas fa-filter me-1"></i> Filters
                        </h5>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <form method="get" class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Search</label>
                                <input type="text" name="searchTerm" class="form-control form-control-sm"
                                       placeholder="Flight #, City, IATA" value="@Context.Request.Query["searchTerm"]" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Status</label>
                                <select name="status" class="form-control form-control-sm">
                                    <option value="">All</option>
                                    <option value="Scheduled" selected="@(Context.Request.Query["status"] == "Scheduled")">Scheduled</option>
                                    <option value="Delayed" selected="@(Context.Request.Query["status"] == "Delayed")">Delayed</option>
                                    <option value="Cancelled" selected="@(Context.Request.Query["status"] == "Cancelled")">Cancelled</option>
                                    <option value="Completed" selected="@(Context.Request.Query["status"] == "Completed")">Completed</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">From Date</label>
                                <input type="date" name="fromDate" class="form-control form-control-sm"
                                       value="@Context.Request.Query["fromDate"]" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">To Date</label>
                                <input type="date" name="toDate" class="form-control form-control-sm"
                                       value="@Context.Request.Query["toDate"]" />
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary btn-sm me-1">
                                    <i class="fas fa-search me-1"></i> Apply
                                </button>
                                <a asp-action="Index" class="btn btn-secondary btn-sm">
                                    <i class="fas fa-undo me-1"></i> Reset
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Results Table -->
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped" id="flightsTable">
                    <thead>
                        <tr>
                            <th>Flight</th>
                            <th>Route</th>
                            <th>Departure</th>
                            <th>Arrival</th>
                            <th>Duration</th>
                            <th>Seats</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th style="width: 120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var flight in Model)
                        {
                            var statusColor = flight.Status switch
                            {
                                "Scheduled" => "bg-info",
                                "Delayed" => "bg-warning",
                                "Cancelled" => "bg-danger",
                                "Completed" => "bg-success",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td>
                                    <strong>@flight.FlightNum</strong>
                                </td>
                                <td>
                                    <span class="badge bg-primary">@flight.DepartureIataCode</span>
                                    <i class="fas fa-arrow-right mx-1"></i>
                                    <span class="badge bg-primary">@flight.ArrivalIataCode</span>
                                </td>
                                <td>
                                    <small>
                                        @flight.DepartureTime.ToString("dd/MM HH:mm")
                                        <br />
                                        <span class="text-muted">@flight.DepartureAirportName</span>
                                    </small>
                                </td>
                                <td>
                                    <small>
                                        @flight.ArrivalTime.ToString("dd/MM HH:mm")
                                        <br />
                                        <span class="text-muted">@flight.ArrivalAirportName</span>
                                    </small>
                                </td>
                                <td>@flight.DurationHours</td>
                                <td>@flight.AvailableSeats</td>
                                <td>$@flight.BasePrice.ToString("N0")</td>
                                <td>
                                    <span class="badge @statusColor">@flight.Status</span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@flight.FlightId"
                                           class="btn btn-warning btn-sm" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@flight.FlightId"
                                           class="btn btn-danger btn-sm" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-plane fa-4x text-muted mb-3"></i>
                <h5 class="text-muted">No flights found</h5>
                <p class="text-muted">Click "Add New Flight" to create your first flight.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i> Add New Flight
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($('#flightsTable tbody tr').length > 0) {
                $('#flightsTable').DataTable({
                    language: {
                        search: "Search:",
                        lengthMenu: "Show _MENU_ entries",
                        info: "Showing _START_ to _END_ of _TOTAL_ flights",
                    },
                    order: [[2, 'desc']],
                    pageLength: 10
                });
            }
        });
    </script>
}