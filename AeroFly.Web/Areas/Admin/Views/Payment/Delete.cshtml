@model PaymentListVM
@{
    ViewData["Title"] = "Delete Payment";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title">
                    <i class="fas fa-exclamation-triangle me-2"></i> Delete Payment
                </h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong>Are you sure you want to delete this payment?</strong>
                    <p class="mt-2 mb-0">This action cannot be undone.</p>
                </div>

                <div class="card bg-light mb-3">
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Transaction Ref</dt>
                            <dd class="col-sm-8"><code>@Model.TransactionRef</code></dd>

                            <dt class="col-sm-4 text-muted">PNR</dt>
                            <dd class="col-sm-8"><strong>@Model.PNR</strong></dd>

                            <dt class="col-sm-4 text-muted">Passenger</dt>
                            <dd class="col-sm-8">@Model.PassengerName</dd>

                            <dt class="col-sm-4 text-muted">Flight</dt>
                            <dd class="col-sm-8">@Model.FlightNumber</dd>

                            <dt class="col-sm-4 text-muted">Amount</dt>
                            <dd class="col-sm-8"><strong>$@Model.Amount.ToString("N2")</strong></dd>

                            <dt class="col-sm-4 text-muted">Payment Method</dt>
                            <dd class="col-sm-8">@Model.PayMethod</dd>

                            <dt class="col-sm-4 text-muted">Payment Date</dt>
                            <dd class="col-sm-8">@Model.PayDate.ToString("dd/MM/yyyy HH:mm")</dd>

                            <dt class="col-sm-4 text-muted">Status</dt>
                            <dd class="col-sm-8">
                                <span class="badge bg-@Model.StatusColor">@Model.PayStatus</span>
                            </dd>
                        </dl>
                    </div>
                </div>

                <form asp-action="DeleteConfirmed" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.PayId" />

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i> Confirm Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>